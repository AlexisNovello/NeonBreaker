{
  "name": "neon-breaker",
  "version": "1.0.0",
  "private": true,
  "description": "Juego arcade para la expo de Desarrollo de Software",
  "author": "Neon Breaker",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "ar.edu.neonbreaker",
    "productName": "Neon Breaker",
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "scoreboard.js",
      "main.cjs",
      "preload.cjs",
      "score-store.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Neon-Breaker-${version}-portable.${ext}"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  }
}
